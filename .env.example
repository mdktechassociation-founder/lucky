# Node 22 recommended. No paid fallback, no local model needed.
PORT=3000
# Default: route ALL gateway requests, including DNS, through local Tor.
PRIVACY_MODE=tor
TOR_PROXY=socks5h://127.0.0.1:9050
# Explicit opt-out only: PRIVACY_MODE=direct
KILO_MODEL=kilo-auto/free
# Optional: anonymous free access is supported by Kilo; don't add billing credentials.
KILO_API_KEY=
# Recommended for remote/LAN access. Enter this token in the browser, not the URL.
ACCESS_TOKEN=
