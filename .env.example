# Node 22 recommended. No paid fallback, no local model needed.
PORT=3000
# Default: route ALL gateway requests, including DNS, through local Tor.
PRIVACY_MODE=tor
TOR_PROXY=socks5h://127.0.0.1:9050
# Explicit opt-out only: PRIVACY_MODE=direct
KILO_MODEL=kilo-auto/free
# Optional: anonymous free access is supported by Kilo; don't add billing credentials.
KILO_API_KEY=
# Recommended for remote/LAN access. Enter this token in the browser, not the URL.
ACCESS_TOKEN=

# Live search: operator-controlled SearXNG base URL (without /search).
# Remote HTTPS instance routes through Tor. JSON output must be enabled.
SEARXNG_URL=
# Only use 1 with your own localhost/searxng service; configure its upstream Tor egress.
SEARCH_LOCAL=0
# Optional automation; requires nonempty ACCESS_TOKEN. Disabled by default.
ENABLE_BROWSER=0
# Exact trusted HTTPS hosts only, comma-separated; add necessary asset/redirect hosts explicitly.
BROWSER_ALLOWED_HOSTS=example.com,www.example.com
# Browser automation requires Tor and npm run browser:install; no direct browser mode.
ENABLE_PHONE=0
ADB_PATH=adb
# First use List devices, then explicitly allow the authorized device serial and restart.
ADB_ALLOWED_SERIALS=
# Optional Compose search profile only. Generate a random secret before starting SearXNG.
SEARXNG_SECRET=
